# Docker Desktop rehearsal defaults only. Do not reuse these credentials in dev/prod.
APP_NAME="VirtueNet Platform"
APP_ENV=local
APP_KEY=base64:AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=debug

OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false
APP_PORT=8080

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=virtuenet
DB_USERNAME=virtuenet
DB_PASSWORD=virtuenet_local_only
FORWARD_DB_PORT=5432

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6379

PULSE_ENABLED=true
PULSE_PATH=pulse
PULSE_STORAGE_DRIVER=database
PULSE_INGEST_DRIVER=storage
PULSE_SERVER_NAME=app

FILESYSTEM_DISK=local
MAIL_MAILER=log

# Keep external integrations disabled for local container rehearsal unless explicitly testing them.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_REDIRECT_URI="${APP_URL}/auth/lark/callback"
LARK_OPEN_API_URL=https://open.larksuite.com
LARK_ACCOUNTS_URL=https://accounts.larksuite.com
LARK_OAUTH_SCOPE="auth:user.id:read contact:user.email:readonly"
LARK_VERIFICATION_TOKEN=
LARK_ENCRYPT_KEY=
LARK_APPROVAL_ENABLED=false
LARK_APPROVAL_OUTBOUND_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
