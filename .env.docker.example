APP_NAME="Silva Kit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database Configuration (MySQL Container)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=silva_kit
DB_USERNAME=silva_user
DB_PASSWORD=silva_password
DB_ROOT_PASSWORD=root_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
CACHE_STORE=database

# Laravel Pulse
PULSE_ENABLED=true
PULSE_PATH=pulse
PULSE_STORAGE_DRIVER=database
PULSE_INGEST_DRIVER=storage
PULSE_SERVER_NAME=app

# Redis Configuration (Optional Container)
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@silvakit.com"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

LARK_APP_ID=
LARK_APP_SECRET=
LARK_REDIRECT_URI="${APP_URL}/auth/lark/callback"
LARK_OPEN_API_URL=https://open.larksuite.com
LARK_ACCOUNTS_URL=https://accounts.larksuite.com
LARK_OAUTH_SCOPE="auth:user.id:read contact:user.email:readonly"
# Comma-separated email domains allowed to sign in via Lark SSO. Empty = allow all.
LARK_ALLOWED_DOMAINS=
LARK_VERIFICATION_TOKEN=
LARK_ENCRYPT_KEY=
LARK_BOT_NAME=
LARK_DEFAULT_GROUP_PREFIX=

VITE_APP_NAME="${APP_NAME}"
