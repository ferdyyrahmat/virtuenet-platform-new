APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=virtuenet
DB_USERNAME=virtuenet
DB_PASSWORD=

# Read-only source used by platform:import-legacy during migration rehearsal.
LEGACY_DB_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

# Laravel Pulse
PULSE_ENABLED=true
PULSE_PATH=pulse
PULSE_STORAGE_DRIVER=database
PULSE_INGEST_DRIVER=storage
PULSE_SERVER_NAME=app

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

LARK_APP_ID=
LARK_APP_SECRET=
LARK_REDIRECT_URI="${APP_URL}/auth/lark/callback"
LARK_OPEN_API_URL=https://open.larksuite.com
LARK_ACCOUNTS_URL=https://accounts.larksuite.com
LARK_OAUTH_SCOPE="auth:user.id:read contact:user.email:readonly"
LARK_VERIFICATION_TOKEN=
LARK_ENCRYPT_KEY=
LARK_BOT_NAME=
LARK_DEFAULT_GROUP_PREFIX=
LARK_APPROVAL_ENABLED=false
LARK_APPROVAL_OUTBOUND_ENABLED=false
LARK_APPROVAL_NAME="Lark Modified"
LARK_APPROVAL_ADMIN_ID=7383932003449585670
